# =============================================================================
# Book valuation pipeline — live integration configuration
# -----------------------------------------------------------------------------
# Offline tests need no .env. Live operation requires the external Actors and
# original database schema described in docs/LIVE_INTEGRATION.md.
# Optional tuning settings are documented beside their use in src/services/.
# Supply real credentials only in your deployment environment.
# =============================================================================

# --- Core service ---------------------------------------------------------
NODE_ENV=development
PORT=3006
DATABASE_URL=postgresql://books:replace_me@localhost:5432/books
WEBHOOK_SECRET=replace_with_a_long_random_secret
PUBLIC_WEBHOOK_BASE_URL=https://webhook.example.test
LENS_PUBLIC_BASE_URL=https://images.example.test

# --- External Actors ------------------------------------------------------
APIFY_TOKEN=
APIFY_MANUAL_AD_ACTOR_ID=
APIFY_SEARCH_PAGE_ACTOR_ID=
APIFY_PROXY_GROUPS=RESIDENTIAL
APIFY_PROXY_COUNTRY=FR
APIFY_TOKEN2=
GOOGLE_LENS_ACTOR_ID=
ISBNSEARCH_APIFY_ACTOR_ID=
MOMOX_ACTOR_ID=
ISBNSEARCH_APIFY_ENABLED=false
MOMOX_APIFY_FALLBACK_ENABLED=false

# --- Paid providers: enable deliberately after live setup ------------------
SCRAPFLY_KEY=
SCRAPFLY_ENABLED=false
ISBNSEARCH_SCRAPFLY_ENABLED=false
MOMOX_SCRAPFLY_ENABLED=false
SCRAPFLY_USD_PER_CREDIT=0
GIBERT_DEBUG_SCREENSHOTS=false

# --- Workers: disabled in this example ------------------------------------
WEBHOOK_PROCESSING_MODE=queue
JOB_WORKER_ENABLED=false
APIFY_START_WORKER_ENABLED=false
AD_PROCESSING_MAX_CONCURRENCY=1
APIFY_START_MAX_CONCURRENCY=1
PROCESSING_JOB_MAX_ATTEMPTS=3

# --- OpenAI model + pricing -------------------------------------------------
OPENAI_API_KEY=                      # real key only in .env, never committed
OPENAI_MODEL=gpt-5.4-mini             # global fallback for every call site

# Per-call-site model overrides (each falls back to OPENAI_MODEL if unset).
# Keep the main ad extraction strong:
OPENAI_PASS1_MODEL=gpt-5.4-mini
# Repeated validation / fallback calls can usually use cheaper models:
OPENAI_PASS2_CROP_MODEL=gpt-5.4-mini
OPENAI_CATALOG_VERIFY_MODEL=gpt-5.4-nano
OPENAI_AI_ISBN_INLINE_MODEL=gpt-5.4-nano
OPENAI_AI_ISBN_FALLBACK_MODEL=gpt-5.4-nano
OPENAI_PROVIDER_IMAGE_VERIFY_MODEL=gpt-5.4-nano

# Set according to current OpenAI model pricing (USD per 1,000,000 tokens).
# While these are 0, OpenAI cost events record $0 (token/call counts still
# logged) and the backend warns once at startup.
OPENAI_INPUT_USD_PER_1M=0
OPENAI_OUTPUT_USD_PER_1M=0

# --- AI observability (Phase A) ---------------------------------------------
# 1 = log every OpenAI call as [ai-call] site=... ads_id=... duration_ms=... tokens_in/out=...
# 0 = only the per-ad [ai-usage] summary is logged (always on).
AI_COST_DEBUG=0

# --- Safe AI cost caps (env-only; the code already honors these) ------------
# Catalog cover verify (the biggest AI driver) fan-out per ad:
#   CATALOG_MAX_KEYWORD_SEARCHES_PER_AD = books/ad allowed to run cover verify (default 15)
#   CATALOG_MATCH_MAX_COMPARE           = UNIQUE candidate covers compared per book (default 10)
#       Applied AFTER cover-URL dedupe + pipeline-first/title-similarity ranking, so it now
#       actually bounds the union path (previously the union used candidates.length). Lower
#       this (e.g. 2) to push catalog_cover_verify toward the 10–20 calls/ad range.
# Worst case AI calls/ad ≈ books × unique covers; the values below cut 15×~6 down to ~8×3.
CATALOG_MAX_KEYWORD_SEARCHES_PER_AD=8
CATALOG_MATCH_MAX_COMPARE=3
# Optional deterministic pre-AI title filter: drop NON-pipeline candidates whose Jaccard
# title overlap with the detected book is below this (0 = disabled; 0.1 is a safe floor).
# Pipeline ISBNs (the book's own resolved editions) are never dropped.
CATALOG_PREFILTER_TITLE_MIN=0
# Hard safety ceiling on compares per book even if the cap above is misconfigured.
CATALOG_UNION_MAX_COMPARE=30

# v2 AI ISBN fallback: one two-image vision call per held book.
# 0 = unlimited — do NOT use 0 in production. Use a positive cap.
AI_FB_MAX_BOOKS_PER_AD=5

# --- AI feature flags (current state; unchanged by Phase A) -----------------
ENABLE_CATALOG_VERIFY=false          # enable after live setup
ENABLE_AI_ISBN_FALLBACK=false         # enable after live setup
AI_ISBN_FALLBACK_ENABLED=false        # in-extraction AI ISBN recovery (dormant)
ENABLE_PROVIDER_IMAGE_VERIFY=false    # provider image verify (dormant)

# --- Provider lookup concurrency (Momox/Gibert/Scrapfly) --------------------
# ALL provider price lookups (normal ad processing + admin "Demander le prix" +
# the /webhooks/*/ad/:adsId manual batches) pass through ONE shared in-process
# limiter. 1 = strictly serial (safest vs 429s / blocked calls / instability).
# In-process only: with multiple books-api PM2 instances this no longer serializes
# across processes — a DB advisory lock would be required then.
PROVIDER_LOOKUP_MAX_CONCURRENCY=1
PROVIDER_LOOKUP_QUEUE_WARN_AFTER_MS=30000

# --- Async manual provider-price queue (admin "Demander le prix") ------------
# The endpoint enqueues a provider_price_jobs row (migration 010) and returns 202
# immediately; this worker processes them FIFO through the limiter above. Until the
# migration is applied the endpoint falls back to the old synchronous behavior.
PROVIDER_PRICE_WORKER_ENABLED=false
PROVIDER_PRICE_WORKER_POLL_INTERVAL_MS=1500
PROVIDER_PRICE_MAX_CONCURRENCY=1
PROVIDER_PRICE_STALE_MS=900000
PROVIDER_PRICE_MAX_ATTEMPTS=2
